root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,js,mjs,svg,xml,props,targets,csproj}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{sln,slnx}]
indent_style = space
indent_size = 4

[*.{sh,ps1}]
indent_style = space
indent_size = 2
